{
  "name": "hyper-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Trade on Hyperliquid through a mobile-first client.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "bun --cwd apps/mobile start",
    "mobile:android": "bun --cwd apps/mobile android",
    "mobile:ios": "bun --cwd apps/mobile ios",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p examples/tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "typescript": "~6.0.3"
  }
}
