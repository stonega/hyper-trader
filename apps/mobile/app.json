{
  "expo": {
    "name": "Hyper Trader",
    "slug": "hyper-trader",
    "version": "0.1.2",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon-hyper-trader-v5-prism.png",
    "scheme": "hypertrader",
    "updates": {
      "enabled": false
    },
    "extra": {
      "backendOrigin": "https://hyper-trader-backend.stoneflare.workers.dev",
      "eas": {
        "projectId": "fef3cbd7-9d32-46af-8afa-3907e785513c"
      }
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stonegate.hypertrader"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-hyper-trader-v5-prism.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome-hyper-trader-v5-prism.png",
        "backgroundColor": "#071511"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.stonegate.hypertrader"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Hyper Trader to unlock your protected testnet API wallet."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hyper Trader to verify you before unlocking a temporary signing session."
        }
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true,
          "cameraPermission": "Allow Hyper Trader to scan a public wallet address QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "trading-alerts",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-hyper-trader-v5-prism.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#071511"
        }
      ],
      "./plugins/with-android-abi-splits.cjs",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "stonegate"
  }
}
