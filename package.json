{
  "name": "hyper-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Trade on Hyperliquid through a mobile-first client.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "bun --cwd apps/mobile start",
    "mobile:android": "bun --cwd apps/mobile android",
    "mobile:ios": "bun --cwd apps/mobile ios",
    "market-catalog": "bun --cwd apps/api start:catalog",
    "mainnet:preflight": "bun scripts/mainnet-release-readiness.ts",
    "backend:deploy": "bun --cwd apps/api deploy:cloudflare",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:mainnet-source": "bun scripts/mainnet-release-readiness.ts source",
    "check:secrets": "bun scripts/check-secrets.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc -p examples/tsconfig.json",
    "test": "bun test",
    "test:mobile": "bun --cwd apps/mobile test:mobile",
    "test:e2e:mobile": "bun scripts/check-mobile-e2e.ts",
    "test:e2e:mobile:device": "bash scripts/run-mobile-e2e-device.sh",
    "test:notifications": "bun apps/api/test/run-postgres.ts",
    "db:local:up": "bun scripts/local-postgres.ts up",
    "db:local:down": "bun scripts/local-postgres.ts down",
    "db:local:status": "bun scripts/local-postgres.ts status"
  },
  "overrides": {
    "expo-constants": "57.0.14"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "typescript": "~6.0.3"
  },
  "patchedDependencies": {
    "@noble/hashes@1.8.0": "patches/@noble%2Fhashes@1.8.0.patch"
  }
}
